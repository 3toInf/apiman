{
  "name": "apiman",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build --mv3 && wxt build -b firefox --mv3",
    "zip": "wxt zip --mv3 && wxt zip -b firefox --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "lint:extension": "node scripts/lint-extension.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run lint:extension",
    "format": "prettier --write src entrypoints tests scripts wxt.config.ts vitest.config.ts eslint.config.js",
    "format:check": "prettier --check src entrypoints tests scripts wxt.config.ts vitest.config.ts eslint.config.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@noble/hashes": "^2.4.0",
    "dexie": "^4.4.7",
    "jsonpath-rfc9535": "^1.3.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "safe-regex2": "^5.1.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/selenium-webdriver": "^4.35.7",
    "@wxt-dev/module-react": "^1.2.2",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "geckodriver": "^8.0.0",
    "prettier": "^3.10.1",
    "selenium-webdriver": "^4.51.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5",
    "xpath": "^0.0.36"
  }
}
